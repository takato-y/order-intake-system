root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# VBA エディタへの取り込みは CRLF・Shift_JIS 前提のため別扱い
[*.bas]
end_of_line = crlf
charset = unset

# Windows PowerShell 5.1 での文字化けを避けるため ASCII のみで書く
[*.ps1]
end_of_line = crlf
