root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# VBA モジュールは GitHub で読めるよう UTF-8 で保管する。
# VBE へ取り込むときは Shift_JIS（CP932）に変換する（README 参照）
[*.bas]
end_of_line = crlf

# Windows PowerShell 5.1 での文字化けを避けるため ASCII のみで書く
[*.ps1]
end_of_line = crlf
